# ── Application ─────────────────────────────────────────────────
APP_NAME=SentinelX API
APP_ENV=development
APP_VERSION=3.4.0

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://sentinelx_app:CHANGE_ME@localhost:5432/sentinelx_dev

# ── CORS Origins ─────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://10.0.2.2:5173

# ── Authentication ───────────────────────────────────────────────
# Generate a new secret for production:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-this-dev-secret-before-production
JWT_ALGORITHM=HS256

# Access tokens are short-lived and held in memory by the dashboard; the
# browser stays signed in via the HttpOnly refresh cookie below. Raising this
# back to hours would undo most of the benefit of the session redesign.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
# Hard ceiling on one sign-in, regardless of how often it is refreshed.
SESSION_ABSOLUTE_MAX_DAYS=30

# Validated on every token decode — a token minted for a different issuer or
# audience is rejected even if it was signed with this secret.
JWT_ISSUER=sentinelx
JWT_AUDIENCE=sentinelx-api

# ── Browser session cookies ──────────────────────────────────────────
# SESSION_COOKIE_SECURE is unset by default and resolves to true when
# APP_ENV=production, false otherwise — so http://localhost works in dev
# without weakening the production configuration. Production refuses to
# start with it set to false.
# SESSION_COOKIE_SECURE=
#
# "lax" is correct when the dashboard and API share a registrable domain
# (localhost:5173 -> localhost:8000 counts). Use "none" only for a
# split-origin deployment, which also requires SESSION_COOKIE_SECURE=true.
SESSION_COOKIE_SAMESITE=lax
# SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_PATH=/api/v1/auth
SESSION_COOKIE_NAME=sx_refresh
CSRF_COOKIE_NAME=sx_csrf

# ── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_LOGIN=15/minute
RATE_LIMIT_SIGNUP=5/minute
RATE_LIMIT_API=300/minute
RATE_LIMIT_TELEMETRY=120/minute
# Where rate-limit counters live. "auto" (default) uses PostgreSQL, so limits
# hold across API processes with no extra infrastructure. "valkey" points at a
# shared Valkey (docker compose --profile valkey up valkey). "memory" is
# per-process and only correct for a single worker.
RATE_LIMIT_BACKEND=auto
RATE_LIMIT_VALKEY_URL=

# ── Security Headers ─────────────────────────────────────────────
SECURITY_HEADERS_ENABLED=true

# ── Safe Recovery Orchestration (Sprint 3) ────────────────────────
# Kill switch: false disables /recovery-commands and /agent/commands
RECOVERY_ORCHESTRATION_ENABLED=true
# Path to the Ed25519 private key (generate with scripts/generate_recovery_signing_key.py)
RECOVERY_SIGNING_PRIVATE_KEY_PATH=.secrets/recovery_signing_key.pem
RECOVERY_COMMAND_DEFAULT_TTL_SECONDS=300

# --- Production hardening (audit 2026-08-13) ---
# Number of reverse proxies in front of the app. 0 = directly exposed, and
# X-Forwarded-For is ignored (a client can forge it). Set to 1 behind Cloud Run
# so per-IP rate limiting and security-log attribution see the real caller.
TRUSTED_PROXY_COUNT=0

# Pre-v2 opaque device tokens cost an argon2 verification against EVERY active
# credential, so enabling this lets an unauthenticated caller burn O(fleet) CPU
# per request. No token minted since Sprint 1 uses that format. Leave False.
ALLOW_LEGACY_DEVICE_TOKENS=False

# Open public self-registration via POST /auth/signup. True is fine locally.
# With APP_ENV=production this defaults to False even if the line is absent,
# because on a public deployment anyone could create an account and the very
# first one becomes admin. Create the first production admin instead with:
#   python -m app.db.create_admin --email you@example.com --full-name "Your Name"
PUBLIC_SIGNUP_ENABLED=true
